{
  "name": "tamilnadu-restaurant-simulator",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @restaurant/api",
    "dev:web": "npm run dev --workspace @restaurant/web",
    "build": "npm run build --workspace @restaurant/api && npm run build --workspace @restaurant/web",
    "start:api": "npm run start --workspace @restaurant/api",
    "typecheck": "npm run typecheck --workspace @restaurant/api && npm run typecheck --workspace @restaurant/web",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --import=tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "prisma": { "seed": "node --import=tsx prisma/seed.ts" }
}
