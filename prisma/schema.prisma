generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum EmployeeRole {
  SERVER
  MANAGER
  COOK
  DISHWASHER
}
enum EmployeeStatus {
  AVAILABLE
  BUSY
  OFF_DUTY
}
enum TableStatus {
  AVAILABLE
  RESERVED
  SEATED
  ORDERING
  ORDER_PLACED
  FOOD_SERVING
  OCCUPIED
  BILL_REQUESTED
  PAYMENT_PENDING
  CLEANING
}
enum SessionStatus {
  OPEN
  PAYMENT_PENDING
  CLOSED
}
enum OrderStatus {
  DRAFT
  SUBMITTED
  IN_PREPARATION
  PARTIALLY_SERVED
  SERVED
  CANCELLED
}
enum OrderItemStatus {
  QUEUED
  BLOCKED
  PREPARING
  QUALITY_CHECK
  READY_FOR_PICKUP
  PICKED_UP
  SERVED
  CANCELLED
}
enum TaskStatus {
  QUEUED
  ASSIGNED
  IN_PROGRESS
  QUALITY_CHECK
  READY
  COMPLETED
  BLOCKED
  CANCELLED
}
enum StockMovementType {
  RECEIPT
  CONSUMPTION
  ADJUSTMENT
  WASTE
}
enum VesselState {
  CLEAN
  IN_USE
  DIRTY
  QUEUED_FOR_WASHING
  WASHING
  SANITIZING
  DAMAGED
}
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Employee {
  id          String @id @default(cuid())
  employeeNo  String @unique
  name        String
  role        EmployeeRole
  status      EmployeeStatus @default(AVAILABLE)
  station     String?
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sessions    DiningSession[] @relation("SessionServer")
  orders      CustomerOrder[]
  prepTasks   PreparationTask[]
  pickupTasks PickupTask[]
  washingTasks WashingTask[]
  taskHistory AuditLog[]
  assignments TableAssignment[]
  deliveries DeliveryRecord[]
  @@index([role, status, active])
}

model DiningTable {
  id           String @id @default(cuid())
  tableNo      String @unique
  capacity     Int @default(4)
  status       TableStatus @default(AVAILABLE)
  sessions     DiningSession[]
  deliveries   DeliveryRecord[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([status])
}

model DiningSession {
  id          String @id @default(cuid())
  tableId     String
  serverId    String
  partySize   Int
  status      SessionStatus @default(OPEN)
  seatedAt    DateTime @default(now())
  closedAt    DateTime?
  table       DiningTable @relation(fields: [tableId], references: [id])
  server      Employee @relation("SessionServer", fields: [serverId], references: [id])
  orders      CustomerOrder[]
  bill        Bill?
  assignments TableAssignment[]
  washingTasks WashingTask[]
  @@index([tableId, status])
  @@index([serverId, status])
}

model TableAssignment {
  id        String @id @default(cuid())
  sessionId String
  employeeId String
  assignedAt DateTime @default(now())
  releasedAt DateTime?
  session   DiningSession @relation(fields: [sessionId], references: [id])
  employee  Employee @relation(fields: [employeeId], references: [id])
  @@index([employeeId, releasedAt])
}

model MenuCategory {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int @default(0)
  items     MenuItem[]
}

model MenuItem {
  id               String @id @default(cuid())
  categoryId       String
  tamilName        String
  englishName      String
  description      String @db.Text
  pricePaise       Int
  vegetarian       Boolean
  station          String
  prepSeconds      Int
  allergens        String? @db.Text
  active           Boolean @default(true)
  available        Boolean @default(true)
  category         MenuCategory @relation(fields: [categoryId], references: [id])
  recipe           Recipe?
  orderItems       OrderItem[]
  @@index([categoryId, active, available])
  @@index([englishName])
}

model Recipe {
  id          String @id @default(cuid())
  menuItemId  String @unique
  yieldQty    Decimal @default(1) @db.Decimal(10, 3)
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  ingredients RecipeIngredient[]
}

model Ingredient {
  id          String @id @default(cuid())
  name        String @unique
  unit        String
  lowStockAt  Decimal @default(0) @db.Decimal(12, 3)
  stock       IngredientStock?
  recipeUses  RecipeIngredient[]
  movements   InventoryMovement[]
}

model IngredientStock {
  ingredientId String @id
  quantity     Decimal @default(0) @db.Decimal(12, 3)
  updatedAt    DateTime @updatedAt
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
}

model RecipeIngredient {
  recipeId     String
  ingredientId String
  quantity     Decimal @db.Decimal(12, 3)
  recipe       Recipe @relation(fields: [recipeId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  @@id([recipeId, ingredientId])
  @@index([ingredientId])
}

model CustomerOrder {
  id          String @id @default(cuid())
  orderNo     String @unique
  sessionId   String
  serverId    String
  status      OrderStatus @default(DRAFT)
  idempotencyKey String? @unique
  submittedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  session     DiningSession @relation(fields: [sessionId], references: [id])
  server      Employee @relation(fields: [serverId], references: [id])
  items       OrderItem[]
  @@index([sessionId, status])
}

model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  menuItemId    String
  quantity      Int
  unitPricePaise Int
  status        OrderItemStatus @default(QUEUED)
  customizations Json?
  specialInstructions String? @db.Text
  failureReason String? @db.Text
  createdAt     DateTime @default(now())
  preparationTask PreparationTask?
  pickupTasks   PickupTask[]
  deliveries    DeliveryRecord[]
  order         CustomerOrder @relation(fields: [orderId], references: [id])
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id])
  @@index([orderId, status])
}

model PreparationTask {
  id          String @id @default(cuid())
  orderItemId String @unique
  cookId      String?
  station     String
  status      TaskStatus @default(QUEUED)
  progress    Int @default(0)
  startedAt   DateTime?
  expectedAt  DateTime?
  completedAt DateTime?
  exceptionHistory Json?
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  cook        Employee? @relation(fields: [cookId], references: [id])
  @@index([station, status, createdAt])
  createdAt DateTime @default(now())
}

model PickupTask {
  id          String @id @default(cuid())
  orderItemId String
  serverId    String?
  status      TaskStatus @default(QUEUED)
  assignedAt  DateTime?
  pickedUpAt  DateTime?
  deadlineAt  DateTime?
  item        OrderItem @relation(fields: [orderItemId], references: [id])
  server      Employee? @relation(fields: [serverId], references: [id])
  @@index([serverId, status])
  @@index([status, createdAt])
  createdAt DateTime @default(now())
}

model DeliveryRecord {
  id          String @id @default(cuid())
  orderItemId String
  tableId     String
  serverId    String
  deliveredAt DateTime @default(now())
  item        OrderItem @relation(fields: [orderItemId], references: [id])
  table       DiningTable @relation(fields: [tableId], references: [id])
  server      Employee @relation(fields: [serverId], references: [id])
  @@index([tableId, deliveredAt])
}

model Bill {
  id             String @id @default(cuid())
  sessionId      String @unique
  subtotalPaise  Int
  taxPaise       Int @default(0)
  discountPaise  Int @default(0)
  totalPaise     Int
  session        DiningSession @relation(fields: [sessionId], references: [id])
  payments       Payment[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Payment {
  id          String @id @default(cuid())
  billId      String
  amountPaise Int
  method      String
  status      PaymentStatus @default(PENDING)
  reference   String? @unique
  paidAt      DateTime?
  bill        Bill @relation(fields: [billId], references: [id])
  createdAt   DateTime @default(now())
  @@index([billId, status])
}

model VesselType {
  id                String @id @default(cuid())
  name              String @unique
  cleanQty          Int @default(0)
  inUseQty          Int @default(0)
  dirtyQty          Int @default(0)
  washingQty        Int @default(0)
  damagedQty        Int @default(0)
  updatedAt         DateTime @updatedAt
  lowStockAt        Int @default(0)
  tasks             WashingTask[]
  movements         InventoryMovement[]
}

model WashingTask {
  id           String @id @default(cuid())
  sessionId    String?
  vesselTypeId String
  employeeId   String?
  quantity     Int
  status       TaskStatus @default(QUEUED)
  startedAt    DateTime?
  expectedAt   DateTime?
  completedAt  DateTime?
  vesselType   VesselType @relation(fields: [vesselTypeId], references: [id])
  session      DiningSession? @relation(fields: [sessionId], references: [id])
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime @default(now())
  @@index([sessionId, status])
  @@index([status, createdAt])
}

model InventoryMovement {
  id           String @id @default(cuid())
  ingredientId String?
  vesselTypeId String?
  type         StockMovementType
  quantity     Decimal @db.Decimal(12, 3)
  reason       String
  createdAt    DateTime @default(now())
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])
  vesselType   VesselType? @relation(fields: [vesselTypeId], references: [id])
  @@index([ingredientId, createdAt])
  @@index([vesselTypeId, createdAt])
}

model AuditLog {
  id         String @id @default(cuid())
  employeeId String?
  entityType String
  entityId   String
  action     String
  details    Json?
  createdAt  DateTime @default(now())
  employee   Employee? @relation(fields: [employeeId], references: [id])
  @@index([entityType, entityId, createdAt])
  @@index([employeeId, createdAt])
}

model SimulationSettings {
  id                  Int @id @default(1)
  speed               Int @default(1)
  paused              Boolean @default(false)
  taxRateBasisPoints  Int @default(0)
  reworkSeconds       Int @default(120)
  pickupDeadlineSeconds Int @default(180)
  updatedAt           DateTime @updatedAt
}
